# Copy the values below into your shell / credential manager (or a local,
# gitignored .env file). Never commit real values - this file only exists
# to document which variables are needed.
#
# Required for API tests, and for the API-backed test-data setup/teardown
# that UI tests also rely on:
TODOIST_API_TOKEN=

# Used ONLY by the local scripts/generate_storage_state.py (Settings >
# Integrations > Developer in the Todoist app gives you the token above;
# these are your test account's login credentials). NOT read by the CI
# workflows or by any automated UI test - Todoist's login form is behind
# Cloudflare Turnstile, which blocks scripted logins, so UI tests load a
# pre-generated session instead (see TODOIST_STORAGE_STATE_B64 below and
# README.md "How credentials are handled"):
TODOIST_EMAIL=
TODOIST_PASSWORD=

# Optional - used by tests/ui/sharing.robot to invite a collaborator.
# Leave unset to use a placeholder address (only verifies the "pending
# invite" UI state). Set to a real, distinct mailbox you control to also
# verify acceptance - see Docs/BACKLOG.md.
TODOIST_SHARE_TEST_EMAIL=

# Playwright storage state (session cookies) for UI tests, base64-encoded.
# Do NOT set this by hand - generate it by running
# scripts/generate_storage_state.py locally (a human completes the real
# login), then base64-encode the resulting storageState.json. See
# README.md ("How credentials are handled") for the exact commands.
TODOIST_STORAGE_STATE_B64=

# --- CI only (set as GitHub Secrets, never as repository variables) ---
# TODOIST_API_TOKEN, TODOIST_SHARE_TEST_EMAIL, and TODOIST_STORAGE_STATE_B64
# are read from GitHub Secrets by .github/workflows/pr_gate.yml and
# nightly.yml. TODOIST_EMAIL/TODOIST_PASSWORD are also kept as GitHub
# Secrets for convenience but are NOT wired into either CI workflow -
# they only matter when someone runs scripts/generate_storage_state.py
# locally. A RESEND_API_KEY secret is reserved for the nightly email
# summary step (not yet implemented - see Docs/BACKLOG.md).
